variable "nsg_rules" {
  description = "Map of Network Security Group rules to create. Each rule should include the following attributes: name, access, description, direction, priority, protocol, source_port_range, source_port_ranges, source_address_prefix, source_address_prefixes, destination_port_range, destination_port_ranges, destination_address_prefix, and destination_address_prefixes."
 
