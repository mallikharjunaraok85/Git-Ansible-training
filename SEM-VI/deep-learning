resource "azurerm_virtual_network" "vnet" {
  name                = var.name
  resource_group_name = var.resource_group_name
  location            = var.location
  address_space       = [var.address_space]
 
  lifecycle {
    prevent_destroy = true
  }
 
  tags = var.tags
}
 
resource "azurerm_subnet" "subnet" {
  for_each = var.subnets
 
  name                                          = each.value.name == null ? replace(var.name, "rabo-vnet", "${each.key}-snet") : each.value.name
  resource_group_name                           = azurerm_virtual_network.vnet.resource_group_name
  virtual_network_name                          = azurerm_virtual_network.vnet.name
  address_prefixes                              = [each.value.range]
  private_endpoint_network_policies             = var.private_endpoint_network_policies
  private_link_service_network_policies_enabled = each.value.private_link_service_network_policies_enabled
  service_endpoints                             = ["Microsoft.Storage", "Microsoft.KeyVault", "Microsoft.ServiceBus"]
 
  dynamic "delegation" {
    for_each = each.value.delegation != null ? [each.value.delegation] : []
 
    content {
      name = delegation.value.name
 
      service_delegation {
        name    = delegation.value.service_delegation.name
        actions = delegation.value.service_delegation.actions
      }
    }
  }
}
 
resource "azurerm_subnet_route_table_association" "subnet_route_table_association" {
  for_each       = { for k, v in var.subnets : k => v if v.route_table_allowed }
  subnet_id      = azurerm_subnet.subnet[each.key].id
  route_table_id = var.route_table_id
}
 
resource "azurerm_virtual_network_dns_servers" "rabobank_dns" {
  virtual_network_id = azurerm_virtual_network.vnet.id
  dns_servers        = ["10.253.14.71", "10.253.14.72"]
}
 
resource "azurerm_role_assignment" "vnet_role_assignment" {
  scope                = azurerm_virtual_network.vnet.id
  role_definition_name = "Network Contributor"
  principal_id         = "29efd061-ba66-46b3-8c2c-8149a9813e3a"
}
 
 
