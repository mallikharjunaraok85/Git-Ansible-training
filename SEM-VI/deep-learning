resource "azurerm_route_table" "lza_route" {
  for_each            = var.ROUTE_TABLE
  name                = each.value.name
  location            = each.value.route_rg_loc
  resource_group_name = each.value.route_rg_name
 
  route {
    name                   = each.value.route_name
    address_prefix         = each.value.address_prefix
    next_hop_type          = each.value.next_hop_type
    next_hop_in_ip_address = each.value.next_hop_in_ip_address
  }
  lifecycle {
    prevent_destroy = true
  }
  tags = var.tags
}
 
resource "azurerm_subnet_route_table_association" "lza_route-associate" {
  for_each       = var.ROUTE_TABLE_ASSOCIATION
  subnet_id      = var.subnets_map[each.value.subnetname_values].id
  route_table_id = lookup({ for k, lza_route in azurerm_route_table.lza_route : k => lza_route.id }, each.value.name, "what?")
}
 
 
variable "name" {
  description = "The name of the virtual network"
  type        = string
}
 
variable "resource_group_name" {
  description = "The name of the resource group"
  type        = string
}
 
variable "location" {
  description = "The location/region where the virtual network is created"
  type        = string
  default     = "West Europe"
}
 
variable "address_space" {
  description = "The address space that is used by the virtual network."
  type        = string
 
  validation {
    condition     = can(regex("^([0-9]{1,3}\\.){3}[0-9]{1,3}/24$", var.address_space))
    error_message = "The 'address_space' must be a valid CIDR block with a /24 subnet mask, like '192.168.0.0/24'. If you want to use a different adress space it means that SAP LENA is no longer bound to Express Route connected vnets and you need to rewrite this module."
  }
}
 
variable "subnets" {
  description = "values for the subnets to create in the virtual network. The keys are the names of the subnets and the values are the CIDR blocks and ."
  type = map(object({
    range                                         = string
    private_link_service_network_policies_enabled = bool
    name                                          = optional(string, null) # Optional name for the subnet, if not provided it will be derived from the key
    route_table_allowed                           = optional(bool, true)   # Optional flag to allow route table association, default is true
    delegation = optional(object(
      {
        name = string
        service_delegation = object(
          {
            name    = string
            actions = list(string) # Optional actions for the delegation, e.g. ["Microsoft.Network/virtualNetworks/subnets/join/action"]
        })
    }), null)
  }))
}
 
variable "tags" {
  description = "A mapping of tags to assign to the resource."
  type        = map(string)
  default     = {}
}
 
variable "private_endpoint_network_policies" {
  description = "Whether network policies are enabled for the private endpoint."
  type        = string
  default     = null
}
 
variable "route_table_id" {
  description = "The ID of the route table to associate with the subnets."
  type        = string
}
 
