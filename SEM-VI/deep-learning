# ----------------------------------------------------
# Private Endpoint (without lifecycle ignore)
# ----------------------------------------------------
resource "azurerm_private_endpoint" "private_endpoint" {
  count = var.ignore_manual_connection_state ? 0 : 1
 
  name                = var.name
  location            = var.location
  resource_group_name = var.resource_group_name
  subnet_id           = var.subnet_id
  tags                = var.tags
 
  private_service_connection {
    name                           = var.name
    private_connection_resource_id = var.private_service_connection.private_connection_resource_id
    is_manual_connection           = var.is_manual_connection
    request_message                = var.is_manual_connection ? var.request_message : null
    subresource_names              = var.private_service_connection.group_ids
  }
 
  dynamic "private_dns_zone_group" {
    for_each = var.private_dns_zone_id != null ? [1] : []
    content {
      name                 = "entry-in-private-dns-zone-${var.name}"
      private_dns_zone_ids = [var.private_dns_zone_id]
    }
  }
}
 
# ----------------------------------------------------
# Private Endpoint (with lifecycle ignore for manual connections)
# Created when ignore_manual_connection_state = true
# Ignores changes to private_service_connection after manual approval.
# ----------------------------------------------------
resource "azurerm_private_endpoint" "private_endpoint_manual" {
  count = var.ignore_manual_connection_state ? 1 : 0
 
  name                = var.name
  location            = var.location
  resource_group_name = var.resource_group_name
  subnet_id           = var.subnet_id
  tags                = var.tags
 
  private_service_connection {
    name                           = var.name
    private_connection_resource_id = var.private_service_connection.private_connection_resource_id
    is_manual_connection           = var.is_manual_connection
    request_message                = var.is_manual_connection ? var.request_message : null
    subresource_names              = var.private_service_connection.group_ids
  }
 
  dynamic "private_dns_zone_group" {
    for_each = var.private_dns_zone_id != null ? [1] : []
    content {
      name                 = "entry-in-private-dns-zone-${var.name}"
      private_dns_zone_ids = [var.private_dns_zone_id]
    }
  }
 
  lifecycle {
    ignore_changes = [private_service_connection]
  }
}
